# Robot Dock environment template. Copy to .env; never commit a populated .env.
# Process environment takes precedence over file values. No shell interpolation.
# Only selected model integrations read their own credentials.
ROBOT_DOCK_POKEBOT_API_KEY=
ROBOT_DOCK_POKEBOT_BASE_URL=https://api.pokebot.com/v1
ROBOT_DOCK_POKEBOT_MODEL=poke-aurora-preview
# OpenAI-compatible Cartesian planner. DeepSeek Flash is one vision-capable example.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_API_MODEL=deepseek-flash
# Optional provider-specific request options; leave unset for other providers.
# OPENAI_API_EXTRA_BODY={"thinking":{"type":"disabled"}}
# Optional headless Linux renderer; leave unset on desktop Windows.
# MUJOCO_GL=egl
